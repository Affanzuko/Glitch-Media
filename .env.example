# ── LLM (Anthropic Claude) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.4

# ── Image Generation ─────────────────────────────────────────────────────────
IMAGE_GEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_MODEL=dall-e-3

# ── Twitter / X API (API v2 — Elevated access required for posting) ──────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ── Instagram Graph API (requires Facebook Business account) ──────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Reddit API (PRAW) ────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=glitch-media-agent/1.0

# ── YouTube Data API v3 ──────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Steam Web API ─────────────────────────────────────────────────────────────
STEAM_API_KEY=

# ── Pipeline Config ───────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
QUALITY_THRESHOLD=0.6
