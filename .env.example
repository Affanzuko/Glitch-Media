# ── 9Router (Local AI Router - OpenAI-compatible) ───────────────────────────
# Set NINEROUTER_BASE_URL=http://localhost:20128/v1 to use 9router
NINEROUTER_BASE_URL=http://localhost:20128/v1

# ── Per-Agent Model Configuration ────────────────────────────────────────────
# Model IDs from your 9Router
AGENT_SCRAPING_MODEL=ag/gemini-pro-agent
AGENT_SCREENING_MODEL=kr/glm-5
AGENT_CAPTION_X_MODEL=ag/gemini-3.1-pro-low
AGENT_IMAGE_GEN_MODEL=ag/gemini-pro-agent
AGENT_CAPTION_IG_MODEL=ag/gemini-3.1-pro-low
AGENT_UPLOAD_X_MODEL=kr/claude-haiku-4.5-agentic
AGENT_UPLOAD_IG_MODEL=kr/claude-haiku-4.5-agentic

# ── Image Generation ─────────────────────────────────────────────────────────
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=wan2.7-image-pro
IMAGE_GEN_DASHSCOPE_URL=
# ── Twitter / X API (API v2 — Elevated access required for posting) ──────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ── Instagram Graph API (requires Facebook Business account) ──────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Reddit API (PRAW) ────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=glitch-media-agent/1.0

# ── YouTube Data API v3 ──────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Steam Web API ─────────────────────────────────────────────────────────────
STEAM_API_KEY=

# ── Pipeline Config ───────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
QUALITY_THRESHOLD=0.6
