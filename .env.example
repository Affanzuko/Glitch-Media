# ── LLM Provider Mode ────────────────────────────────────────────────────────
# "local" = 9Router (development lokal)
# "cloud" = Alibaba Cloud DashScope API (production / deployment)
LLM_PROVIDER=local

# ── 9Router (Local AI Router - OpenAI-compatible) ───────────────────────────
# Set NINEROUTER_BASE_URL=http://localhost:20128/v1 to use 9router
NINEROUTER_BASE_URL=http://localhost:20128/v1

# ── Alibaba Cloud DashScope API (Production) ────────────────────────────────
# Dapatkan API key di: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── Per-Agent Model Configuration (LOCAL — 9Router) ─────────────────────────
AGENT_SCRAPING_MODEL_LOCAL=ag/gemini-pro-agent
AGENT_SCREENING_MODEL_LOCAL=kr/glm-5
AGENT_CAPTION_X_MODEL_LOCAL=ag/gemini-3.1-pro-low
AGENT_CAPTION_IG_MODEL_LOCAL=ag/gemini-3.1-pro-low
AGENT_IMAGE_GEN_MODEL_LOCAL=ag/gemini-pro-agent

# ── Per-Agent Model Configuration (CLOUD — DashScope) ───────────────────────
# Daftar model: https://www.alibabacloud.com/help/en/model-studio/getting-started/models
AGENT_SCRAPING_MODEL_CLOUD=Qwen3.7-Plus
AGENT_SCREENING_MODEL_CLOUD=deepseek-v4-pro
AGENT_CAPTION_X_MODEL_CLOUD=Qwen3.7-Plus
AGENT_CAPTION_IG_MODEL_CLOUD=Qwen3.7-Plus
AGENT_IMAGE_GEN_MODEL_CLOUD=Qwen3.7-Plus

# ── Per-Agent Fallback Chain (CLOUD) ─────────────────────────────────────────
# Urutan model cadangan per agent. Dicoba kiri ke kanan jika model utama gagal.
# Trigger pindah: token habis, rate limit (429), quota exceeded, error 403
AGENT_FALLBACK_CAPTION_X_CLOUD=qwen-turbo,qwen-max
AGENT_FALLBACK_CAPTION_IG_CLOUD=qwen-turbo,qwen-max
AGENT_FALLBACK_SCREENING_CLOUD=qwen-turbo,qwen-max
AGENT_FALLBACK_SCRAPING_CLOUD=qwen-turbo,qwen-max
AGENT_FALLBACK_IMAGE_GEN_CLOUD=qwen-turbo,qwen-max

# ── Per-Agent Fallback Chain (LOCAL) ─────────────────────────────────────────
AGENT_FALLBACK_CAPTION_X_LOCAL=kr/glm-5
AGENT_FALLBACK_CAPTION_IG_LOCAL=kr/glm-5
AGENT_FALLBACK_SCREENING_LOCAL=kr/glm-5
AGENT_FALLBACK_SCRAPING_LOCAL=kr/glm-5
AGENT_FALLBACK_IMAGE_GEN_LOCAL=kr/glm-5

# ── Image Generation Model Fallback ─────────────────────────────────────────
# Model untuk generate gambar (bukan LLM). Fallback jika model utama gagal.
IMAGE_GEN_MODEL_CHAIN=wan2.7-image-pro,qwen-image-3.0-pro

# ── Image Generation ─────────────────────────────────────────────────────────
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=wan2.7-image-pro
IMAGE_GEN_DASHSCOPE_URL=https://ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/image-generation/generation

# ── Twitter / X API (API v2 — Elevated access required for posting) ──────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ── Twitter / X OAuth 2.0 (User login via browser) ──────────────────────────
# Buat OAuth 2.0 App di https://developer.twitter.com/en/portal/projects
# Set Redirect URI ke http://127.0.0.1:9274/callback/x
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://127.0.0.1:9274/callback/x

# ── Instagram Graph API (requires Facebook Business account) ──────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Instagram OAuth (Facebook Login) ─────────────────────────────────────────
# Buat App di https://developers.facebook.com/apps/
# Set Redirect URI ke http://127.0.0.1:9274/callback/ig
IG_OAUTH_APP_ID=
IG_OAUTH_APP_SECRET=
IG_OAUTH_REDIRECT_URI=http://127.0.0.1:9274/callback/ig

# ── OAuth Server ──────────────────────────────────────────────────────────────
OAUTH_SERVER_PORT=9274

# ── Reddit API (PRAW) ────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=glitch-media-agent/1.0

# ── YouTube Data API v3 ──────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Steam Web API ─────────────────────────────────────────────────────────────
STEAM_API_KEY=

# ── Database Configuration ─────────────────────────────────────────────────────
# Format MySQL: mysql+pymysql://user:password@host:port/dbname
DATABASE_URL=mysql+pymysql://root:@localhost:3306/glitch_media

# ── Pipeline Config ───────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
QUALITY_THRESHOLD=0.6

LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
